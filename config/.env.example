# Minikube Development Environment Configuration
# Copy this file to .env and customize as needed

# Cluster Configuration
CLUSTER_NAME=minikube
DRIVER=docker
CPUS=4
MEMORY=8192
KUBERNETES_VERSION=stable

# DNS Configuration
# Domain pattern: <name>.<namespace>.<DOMAIN>
# Example: dashboards.opensearch.minikube.local
DOMAIN=minikube.local

# GitLab Integration (for ArgoCD GitOps)
# Your self-hosted GitLab URL (without https://)
GITLAB_HOST=gitlab.example.com
# GitLab group/organization name
GITLAB_ORG=your-org
# GitOps repository name
GITLAB_REPO=gitops-apps
# GitLab access token (read_repository scope)
# Create at: GitLab → Settings → Access Tokens
GITLAB_TOKEN=glpat-xxxxxxxxxxxx
